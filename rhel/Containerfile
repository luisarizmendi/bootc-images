ARG BASE_IMAGE_RELEASE='10'
ARG BASE_IMAGE_TAG='10.2'

FROM registry.redhat.io/rhel${BASE_IMAGE_RELEASE}/rhel-bootc:${BASE_IMAGE_TAG}
    

RUN dnf install -y greenboot greenboot-default-health-checks && \
    dnf clean all

COPY files/ /

RUN chmod +x /usr/local/bin/* && \
    systemctl enable first-boot.service

