# syntax=docker/dockerfile:1
ARG BASE_IMAGE=quay.io/redhat-user-workloads/jetpack-for-rhel-tenant/rhel-98-bootc:latest

###############################################################################
# Stage 1: build llama.cpp with CUDA for Jetson Orin (sm_87) and fetch model
###############################################################################
FROM ${BASE_IMAGE} AS builder

ARG LLAMA_CPP_REF=master
ARG CUDA_ARCH=87
ARG MODEL_REPO=bartowski/Qwen_Qwen3.5-4B-GGUF
ARG MODEL_FILE=Qwen_Qwen3.5-4B-Q4_K_M.gguf

# NOTE: CUDA package names depend on the JetPack repo shipped in the base image.
# Check with: dnf search cuda-toolkit cuda-nvcc
#RUN dnf -y install \
#      gcc gcc-c++ make cmake git python3-pip libcurl-devel \
#      cuda-toolkit \
#    && dnf clean all

ENV PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64

RUN git clone https://github.com/ggml-org/llama.cpp /src/llama.cpp \
    && cd /src/llama.cpp && git checkout ${LLAMA_CPP_REF} \
    && cmake -B build \
         -DGGML_CUDA=ON \
         -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
         -DGGML_NATIVE=ON \
         -DLLAMA_CURL=ON \
         -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j"$(nproc)" --target llama-server \
    && cmake --install build --prefix /opt/llama.cpp

RUN pip3 install --no-cache-dir "huggingface_hub[cli]" \
    && mkdir -p /models \
    && huggingface-cli download ${MODEL_REPO} ${MODEL_FILE} --local-dir /models

###############################################################################
# Stage 2: final bootc image
###############################################################################
FROM ${BASE_IMAGE}

ARG MODEL_FILE=Qwen_Qwen3.5-4B-Q4_K_M.gguf

# Runtime CUDA libs only (no compiler)
RUN dnf -y install cuda-cudart libcurl \
    && dnf clean all

COPY --from=builder /opt/llama.cpp /opt/llama.cpp
COPY --from=builder /models/${MODEL_FILE} /usr/share/models/${MODEL_FILE}

RUN echo "/opt/llama.cpp/lib64" > /etc/ld.so.conf.d/llama-cpp.conf \
    && echo "/opt/llama.cpp/lib"  >> /etc/ld.so.conf.d/llama-cpp.conf \
    && ldconfig \
    && ln -s /opt/llama.cpp/bin/llama-server /usr/local/bin/llama-server

# Runtime config (edit on the device: /etc/llama-server.env)
RUN cat > /etc/llama-server.env <<EOF
MODEL_PATH=/usr/share/models/${MODEL_FILE}
# 8 GB shared CPU/GPU memory: keep context modest and use a quantized KV cache
CTX_SIZE=8192
N_GPU_LAYERS=99
KV_TYPE=q8_0
PARALLEL=1
# 0 = thinking off (faster, far fewer tokens); -1 = unlimited thinking
REASONING_BUDGET=0
HOST=0.0.0.0
PORT=8080
EOF

RUN cat > /usr/lib/systemd/system/llama-server.service <<'EOF'
[Unit]
Description=llama.cpp server (Qwen3) on Jetson
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/llama-server.env
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64
# Unified memory lets the iGPU spill into system RAM instead of OOMing
Environment=GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
# Best-effort max performance mode (ignored if tools are absent)
ExecStartPre=-/usr/sbin/nvpmodel -m 0
ExecStartPre=-/usr/bin/jetson_clocks
ExecStart=/usr/local/bin/llama-server \
  --model ${MODEL_PATH} \
  --ctx-size ${CTX_SIZE} \
  --n-gpu-layers ${N_GPU_LAYERS} \
  --cache-type-k ${KV_TYPE} --cache-type-v ${KV_TYPE} \
  --parallel ${PARALLEL} \
  --no-mmap \
  --flash-attn on \
  --reasoning-budget ${REASONING_BUDGET} \
  --jinja \
  --host ${HOST} --port ${PORT}
Restart=on-failure
RestartSec=5
# Needs access to the Jetson GPU nodes
SupplementaryGroups=video render

[Install]
WantedBy=multi-user.target
EOF

RUN systemctl enable llama-server.service \
    && (firewall-offline-cmd --add-port=8080/tcp || true)

LABEL org.opencontainers.image.description="RHEL 9.8 bootc + llama.cpp (CUDA) + Qwen3.5/3.8-family GGUF for Jetson Orin Nano"

RUN bootc container lint