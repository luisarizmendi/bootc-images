[Unit]
Description=IdM Server Installation
After=network-online.target firewalld.service usr-share-ipa-html.mount
Wants=network-online.target firewalld.service usr-share-ipa-html.mount
ConditionPathExists=!/etc/ipa/default.conf
Before=certmonger.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/idm-server-install.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target