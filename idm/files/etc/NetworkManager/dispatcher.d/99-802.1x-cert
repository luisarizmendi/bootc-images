#!/bin/bash
# NetworkManager dispatcher script to configure 802.1x with certmonger certificate

INTERFACE=$1
ACTION=$2

if [ "$ACTION" = "up" ]; then
    # Check if certificate exists
    if [ -f /etc/pki/tls/certs/802.1x-client.crt ] && \
       [ -f /etc/pki/tls/private/802.1x-client.key ]; then
        
        # Get CA certificate from IdM
        CA_CERT="/etc/ipa/ca.crt"
        
        # Configure 802.1x connection (example - adjust for your network)
        # This assumes you have a connection profile named "wired-802.1x"
        # You would create this profile with nmcli or configure it in your bootc image
        
        nmcli connection modify "$CONNECTION_ID" \
            802-1x.eap tls \
            802-1x.identity "host/$(hostname)@${IPA_REALM}" \
            802-1x.client-cert "/etc/pki/tls/certs/802.1x-client.crt" \
            802-1x.private-key "/etc/pki/tls/private/802.1x-client.key" \
            802-1x.ca-cert "$CA_CERT" \
            2>/dev/null || true
    fi
fi