[Unit]
Description=Setup 802.1X Certificate with IdM Integration
Documentation=man:ipa-client-install(1) man:getcert(1)
After=network-online.target NetworkManager.service
Wants=network-online.target
ConditionPathExists=!/var/lib/setup-8021x-cert.done
ConditionPathExists=/etc/sysconfig/setup-8021x-cert

[Service]
Type=oneshot
EnvironmentFile=/etc/sysconfig/setup-8021x-cert
ExecStart=/usr/local/bin/setup-8021x-cert.sh
StandardOutput=journal
StandardError=journal
TimeoutSec=600
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Retry until successful
Restart=on-failure
RestartSec=120
StartLimitBurst=0

[Install]
WantedBy=multi-user.target