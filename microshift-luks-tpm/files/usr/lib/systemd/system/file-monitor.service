[Unit]
Description=File System Monitor Service
After=network.target multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/file-monitor.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables (optional - customize as needed)
Environment="FILE_MONITOR_CONFIG=/etc/file-monitor/monitor.conf"
Environment="FILE_MONITOR_LOG=/var/log/file-monitor.log"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target