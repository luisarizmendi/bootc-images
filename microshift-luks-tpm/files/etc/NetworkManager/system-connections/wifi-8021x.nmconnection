[connection]
id=wifi-8021x
type=wifi
autoconnect=true
interface-name=wlP1p1s0

[wifi]
ssid=YOUR_WIFI_NAME
mode=infrastructure

[wifi-security]
key-mgmt=wpa-eap

[802-1x]
eap=tls;
identity=bootstrap-client
ca-cert=/etc/pki/ca-trust/source/anchors/ca.crt
client-cert=/etc/pki/tls/bootstrap/8021x-bootstrap.pem
private-key=/etc/pki/tls/bootstrap/8021x-bootstrap.key
private-key-password-flags=0

[ipv4]
method=auto

[ipv6]
method=auto
