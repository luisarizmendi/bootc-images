## Shared Anaconda installer environment for RHEL 10 bootc payloads.
## Lives under _base_anaconda_images_/ (not a regular app directory) so it
## reads clearly as build infrastructure rather than something deployed.
##
## This image is NOT deployed to any device. It is only ever used as the
## --bootc-ref (installer environment) when building a bootc-generic-iso,
## paired with an app's own image passed as --bootc-installer-payload-ref.
##
## Keep this generic: no kickstart, no per-app config. Per-app ISO details
## (kickstart, grub label/entries) live in <app>/installer/ directories that
## FROM this image. Rebuild this only when Anaconda/tooling itself needs to
## change; app teams should not need to touch it.

FROM registry.redhat.io/rhel10/rhel-bootc:10.2

# grub2-efi-x64-cdboot/grub2-pc-modules are x86_64-only (arm64 has no BIOS
# boot at all, so no grub2-pc-modules equivalent); arm64 uses
# grub2-efi-aa64-cdboot instead. TARGETARCH is set automatically by
# buildah/podman from --platform, no --build-arg needed.
ARG TARGETARCH

RUN set -eu; \
    case "$TARGETARCH" in \
      arm64) GRUB_PKGS="grub2-efi-aa64-cdboot shim-aa64" ;; \
      *) GRUB_PKGS="grub2-efi-x64-cdboot grub2-pc-modules shim-x64" ;; \
    esac; \
    dnf install -y \
        anaconda \
        anaconda-install-env-deps \
        dracut-config-generic \
        dracut-network \
        grub2-common \
        xorriso \
        squashfs-tools \
        jq \
        $GRUB_PKGS && \
    dnf clean all

# Confirmed by testing: on RHEL, shim-x64/grub2-efi-x64-cdboot (and the
# aa64 equivalents) write shimx64.efi, mmx64.efi, gcdx64.efi directly to
# /boot/efi/EFI/redhat/ as part of the package install itself, no copy
# step needed. This differs from the Fedora upstream example, which
# vendors them under /usr/lib/efi/*/*/EFI instead (that path doesn't
# exist on RHEL at all). Ignore /usr/lib/bootupd/updates/EFI/... too:
# that's bootupd's own update payload for a running bootc system, not
# what image-builder's ISO contract reads at build time.
# Verified for x86_64/RHEL10; arm64 and RHEL9 assumed to follow the same
# shim/grub2 naming convention (x64 -> aa64 suffix) but not individually
# confirmed, so this fails loudly with the real directory contents if
# that assumption is wrong.
RUN set -eu; \
    case "$TARGETARCH" in \
      arm64) SUFFIX="aa64" ;; \
      *) SUFFIX="x64" ;; \
    esac; \
    for f in "shim${SUFFIX}.efi" "mm${SUFFIX}.efi" "gcd${SUFFIX}.efi"; do \
        if [ ! -f "/boot/efi/EFI/redhat/$f" ]; then \
            echo "ERROR: expected /boot/efi/EFI/redhat/$f after installing shim/grub2-efi packages, but it is missing."; \
            echo "--- contents of /boot/efi/EFI ---"; \
            find /boot/efi/EFI 2>&1 || echo "(/boot/efi/EFI does not exist)"; \
            exit 1; \
        fi; \
    done; \
    echo "Confirmed shim/grub2 EFI binaries present under /boot/efi/EFI/redhat/"

# Let Anaconda run as an installer environment instead of a normal login.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -sf /usr/lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator && \
    ln -sf /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

RUN mkdir -p "$(realpath /root)"

# Rebuild the initramfs with the anaconda dracut module so the kernel we
# ship can actually boot into the installer.
RUN kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') && \
    DRACUT_NO_XATTR=1 dracut --force -v --reproducible --no-hostonly \
        --add "anaconda" \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"