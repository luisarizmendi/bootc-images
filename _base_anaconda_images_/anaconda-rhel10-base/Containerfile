## Shared Anaconda installer environment for RHEL 10 bootc payloads.
## Lives under _base_anaconda_images_/ (not a regular app directory) so it
## reads clearly as build infrastructure rather than something deployed.
##
## This image is NOT deployed to any device. It is only ever used as the
## --bootc-ref (installer environment) when building a bootc-generic-iso,
## paired with an app's own image passed as --bootc-installer-payload-ref.
##
## Keep this generic: no kickstart, no per-app config. Per-app ISO details
## (kickstart, grub label/entries) live in <app>/installer/ directories that
## FROM this image. Rebuild this only when Anaconda/tooling itself needs to
## change; app teams should not need to touch it.
FROM registry.redhat.io/rhel10/rhel-bootc:10.2

# grub2-efi-x64-cdboot/grub2-pc-modules are x86_64-only (arm64 has no BIOS
# boot at all, so no grub2-pc-modules equivalent); arm64 uses
# grub2-efi-aa64-cdboot instead. TARGETARCH is set automatically by
# buildah/podman from --platform, no --build-arg needed.
ARG TARGETARCH

# shim-x64 (confirmed) and possibly grub2-common/grub2-efi-*-cdboot ship
# already "installed" in the rhel-bootc base image's RPM database, but
# bootc's image compose step strips their actual /boot/efi payload (that
# partition is managed separately by bootupd on a real bootc system, not
# baked into the container). A plain dnf install is then a no-op for
# anything already marked installed, so it never re-extracts the missing
# files. dnf reinstall forces it.
RUN set -eu; \
    case "$TARGETARCH" in \
      arm64) GRUB_PKGS="grub2-efi-aa64-cdboot shim-aa64"; DEVNAME_PKGS="prefixdevname" ;; \
      *) GRUB_PKGS="grub2-efi-x64-cdboot grub2-pc-modules shim-x64"; DEVNAME_PKGS="biosdevname prefixdevname" ;; \
    esac; \
    dnf install -y \
        anaconda \
        anaconda-install-env-deps \
        anaconda-dracut \
        dracut-config-generic \
        dracut-network \
        audit \
        grub2-common \
        xorriso \
        squashfs-tools \
        lorax-templates-rhel \
        python3-mako \
        $DEVNAME_PKGS \
        $GRUB_PKGS && \
    dnf reinstall -y grub2-common $GRUB_PKGS && \
    dnf clean all

# Verify the reinstall above actually produced the required files. If
# this still fails, some other package is also pre-baked-but-stripped in
# the base image the same way shim-x64 was (dnf reinstall -y <pkg> is the
# fix for whichever one it turns out to be); the rpm -q listing below
# shows exactly which package should own the missing file.
RUN set -eu; \
    case "$TARGETARCH" in \
      arm64) SUFFIX="aa64" ;; \
      *) SUFFIX="x64" ;; \
    esac; \
    for f in "shim${SUFFIX}.efi" "mm${SUFFIX}.efi" "gcd${SUFFIX}.efi"; do \
        if [ ! -f "/boot/efi/EFI/redhat/$f" ]; then \
            echo "ERROR: expected /boot/efi/EFI/redhat/$f after installing/reinstalling shim/grub2-efi packages, but it is missing."; \
            echo "--- contents of /boot/efi/EFI ---"; \
            find /boot/efi/EFI 2>&1 || echo "(/boot/efi/EFI does not exist)"; \
            echo "--- which package should own it ---"; \
            rpm -qf "/boot/efi/EFI/redhat/$f" 2>&1 || true; \
            exit 1; \
        fi; \
    done; \
    echo "Confirmed shim/grub2 EFI binaries present under /boot/efi/EFI/redhat/"


# Let Anaconda run as an installer environment instead of a normal login.




# these things are normally performed by `lorax` to make `anaconda` work; this is the
# bare minimum to get things to work

RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

RUN mkdir /usr/lib/systemd/logind.conf.d
COPY <<EOT /usr/lib/systemd/logind.conf.d/anaconda-shell.conf
[Login]
ReserveVT=2
EOT

RUN mkdir "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "anaconda" \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

RUN mkdir /etc/systemd/user/pipewire.service.d/
COPY <<EOT /etc/systemd/user/pipewire.service.d/allowroot.conf
[Unit]
ConditionUser=
EOT

RUN mkdir /etc/systemd/user/pipewire.socket.d/
COPY <<EOT /etc/systemd/user/pipewire.socket.d/allowroot.conf
[Unit]
ConditionUser=
EOT


