#!/usr/bin/env bash
set -Eeuo pipefail

export MOZ_ENABLE_WAYLAND=1

CONFIG_FILE="/etc/kiosk/kiosk.conf"
DEFAULT_URL="file:///var/home/kiosk/.config/flightctl-enrollment-page.html"
FIREFOX_PID=""

get_url() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    fi

    local url="${KIOSK_URL:-$DEFAULT_URL}"

    # Also accept a plain absolute local path in kiosk.conf.
    if [[ "$url" == /* ]]; then
        url="file://$url"
    fi

    printf '%s\n' "$url"
}

wait_for_url() {
    local url="$1"
    local local_file

    case "$url" in
        file:///*)
            local_file="${url#file://}"

            while [[ ! -r "$local_file" ]]; do
                echo "Waiting for local kiosk page: $local_file"
                sleep 5
            done
            ;;

        http://*|https://*)
            while ! curl -fsS --connect-timeout 5 "$url" -o /dev/null; do
                echo "Waiting for the Kiosk APP to become available at $url ..."
                sleep 10
            done
            ;;

        *)
            echo "ERROR: Unsupported KIOSK_URL: $url" >&2
            echo "Use file:///path/to/page.html, /path/to/page.html, http://..., or https://..." >&2
            exit 1
            ;;
    esac
}

launch_firefox() {
    local url="$1"

    wait_for_url "$url"

    echo "Launching Firefox kiosk with: $url"
    /usr/bin/firefox --kiosk "$url" &
    FIREFOX_PID=$!
}

stop_firefox() {
    if [[ -n "${FIREFOX_PID:-}" ]]; then
        kill "$FIREFOX_PID" 2>/dev/null || true
        wait "$FIREFOX_PID" 2>/dev/null || true
        FIREFOX_PID=""
    fi
}

CURRENT_URL="$(get_url)"
launch_firefox "$CURRENT_URL"

if command -v inotifywait >/dev/null 2>&1; then
    while inotifywait -e close_write,create,move "$(dirname "$CONFIG_FILE")" >/dev/null 2>&1; do
        NEW_URL="$(get_url)"

        if [[ "$NEW_URL" != "$CURRENT_URL" ]]; then
            echo "URL changed: $CURRENT_URL -> $NEW_URL"
            CURRENT_URL="$NEW_URL"
            stop_firefox
            launch_firefox "$CURRENT_URL"
        fi
    done
else
    while true; do
        sleep 5
        NEW_URL="$(get_url)"

        if [[ "$NEW_URL" != "$CURRENT_URL" ]]; then
            echo "URL changed: $CURRENT_URL -> $NEW_URL"
            CURRENT_URL="$NEW_URL"
            stop_firefox
            launch_firefox "$CURRENT_URL"
        fi
    done
fi