## Per-app installer for the "rhel" bootc image.
##
## Everything heavy (Anaconda, dracut, EFI plumbing) lives in the shared
## ../../anaconda-rhel10-base image, built once and reused by every app.
## This layer only adds the two files that differ per app: the kickstart
## and the ISO/grub config. Edit those two files here, not the GitHub
## Actions workflow. This image is built locally at artifact-build time
## (see .buildconfig's "installer_base:" key) and is never pushed to a
## registry on its own.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY kickstart.ks /usr/share/anaconda/interactive-defaults.ks
