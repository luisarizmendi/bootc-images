FROM ghcr.io/luisarizmendi/bootc-rhel-jetson:latest

##########

# To enable podman-compose application support
RUN dnf -y install https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm && \
    dnf -y install podman-compose && \
    dnf -y clean all && \
    rm -rf /var/{cache,log} /var/lib/{dnf,rhsm} && \
    systemctl enable podman.service

# Additional packages
RUN dnf -y install \
            tmux \
            python3-pip \
            git && \
    dnf -y clean all
#            NetworkManager-wifi

### Copy files
COPY files/ /

## Include WIFI config
#RUN --mount=type=secret,id=WIFI_SSID --mount=type=secret,id=WIFI_PASSWORD \
#    sed -i "s/YOUR_WIFI_NAME/$(cat /run/secrets/WIFI_SSID | tr -d '\n')/g" /etc/NetworkManager/system-connections/wifi.nmconnection  && \
#    sed -i "s/YOUR_WIFI_PASSWORD/$(cat /run/secrets/WIFI_PASSWORD | tr -d '\n')/g" /etc/NetworkManager/system-connections/wifi.nmconnection

RUN chmod -R 600 /etc/NetworkManager/system-connections/ && \
    chmod +x /usr/local/bin/set-hostname-from-mac.sh && \
    systemctl enable mac-hostname.service


################################################################################
######################    USER FOR ROOTLESS CONTAINERS  ########################
################################################################################

# useradd writes to /etc (committed by ostree) — OK.
# -M skips home dir creation since /var/home is not committed anyway.
RUN useradd -M -d /var/home/detector detector && \
    grep video /usr/lib/group | tee -a /etc/group && \
    usermod -aG video detector

# Create a dedicated gpu group (GID 980, pick any free GID)
RUN groupadd -r -g 980 gpu && \
    usermod -aG gpu detector

# Required for user sessions
RUN systemctl enable systemd-logind.service

# Required for /run/user/<uid>
RUN systemctl enable user-runtime-dir@detector.service

RUN systemctl enable tegra-dev-perms.service

################################################################################
######################    EMBED MODEL    #######################################
################################################################################

## Not included under /files since size is greater than 200Mb and we store it in GitHub
RUN mkdir -p /usr/local/share/models/ && \
    curl -L -o /usr/local/share/models/model.pt https://github.com/ultralytics/assets/releases/download/v8.4.0/yolo26n.pt

RUN chmod +x /usr/local/bin/export-yolo-onnx.py && \
    pip install ultralytics && \
    python /usr/local/bin/export-yolo-onnx.py /usr/local/share/models/model.pt && \
    chmod 755 -R /usr/local/share/models/

# The .engine file will be created on first run: [INFO] Building TRT engine from /opt/models/model.onnx (this may take several minutes)


################################################################################
######################    EMBED IMAGES   #######################################
################################################################################

RUN groupadd -r cstore && \
    usermod -aG cstore detector
    
############ Script permissions and systemd enable ############
RUN chmod 755 /usr/local/bin/embed_image.sh && \
    chmod 755 /usr/local/bin/copy_embedded_images.sh && \
    systemctl enable copy-embedded-images.service

############ Images to embed ############
RUN /usr/local/bin/embed_image.sh quay.io/luisarizmendi/object-detection-custom-camera-capture:latest --user detector
RUN /usr/local/bin/embed_image.sh quay.io/luisarizmendi/object-detection-custom-inference-tensorrt-jetson:latest --user detector
RUN /usr/local/bin/embed_image.sh quay.io/luisarizmendi/object-detection-custom-stream-viewer:latest --user detector