[Unit]
Description=Configure device on first boot
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/firstboot.done
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/first-boot.sh
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target