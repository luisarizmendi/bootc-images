# =============================================================================
# RHEL bootc Image — Real-Time Kernel (amd64 + aarch64)
# =============================================================================
#
# Build arguments:
#   TUNED_PROFILE     — TuneD profile to activate at first boot
#                       Valid: realtime | realtime-virtual-host | realtime-virtual-guest
#                       Default: realtime
#
#   ISOLATED_CPUS     — CPU list to isolate (kernel cmdline + tuned)
#                       Examples: "2-15"  "1,3,5-7"  "2-7,10-15"
#                       Default: "" (no isolation baked in)
#
#   HOUSEKEEPING_CPUS — CPUs reserved for OS housekeeping (complement of ISOLATED_CPUS)
#                       Default: "0,1"
#
#   EXTRA_KARGS       — Additional kernel arguments applied to all architectures
#                       Example: "skew_tick=1 tsc=reliable"
#                       Default: "" (none)
#
# Build examples:
#   # amd64 — bare metal, isolate CPUs 2-15
#   podman build \
#     --platform linux/amd64 \
#     --build-arg TUNED_PROFILE=realtime \
#     --build-arg ISOLATED_CPUS="2-15" \
#     --build-arg HOUSEKEEPING_CPUS="0,1" \
#     -t rhel-bootc-rt:amd64 .
#
#   # aarch64 — KVM host, isolate CPUs 4-31
#   podman build \
#     --platform linux/arm64 \
#     --build-arg TUNED_PROFILE=realtime-virtual-host \
#     --build-arg ISOLATED_CPUS="4-31" \
#     --build-arg HOUSEKEEPING_CPUS="0-3" \
#     -t rhel-bootc-rt:arm64 .
#
#   # Multi-arch manifest
#   podman manifest create rhel-bootc-rt
#   podman build --platform linux/amd64 --build-arg TUNED_PROFILE=realtime \
#     --build-arg ISOLATED_CPUS="2-15" -t rhel-bootc-rt:amd64 .
#   podman build --platform linux/arm64 --build-arg TUNED_PROFILE=realtime \
#     --build-arg ISOLATED_CPUS="4-31" -t rhel-bootc-rt:arm64 .
#   podman manifest add rhel-bootc-rt rhel-bootc-rt:amd64
#   podman manifest add rhel-bootc-rt rhel-bootc-rt:arm64
#   podman manifest push rhel-bootc-rt quay.io/yourorg/rhel-bootc-rt:latest
# =============================================================================

FROM registry.redhat.io/rhel10/rhel-bootc:latest

# ---------------------------------------------------------------------------
# Build-time arguments
# ---------------------------------------------------------------------------
ARG TARGETARCH
ARG TUNED_PROFILE=realtime
ARG ISOLATED_CPUS=""
ARG HOUSEKEEPING_CPUS="0,1"
ARG EXTRA_KARGS=""

# ---------------------------------------------------------------------------
# 1. Repository setup — arch-aware repo names
#
#    NOTE on aarch64: kernel-rt for aarch64 was introduced in RHEL 9.
#    Verify that rhel-10-for-aarch64-rt-rpms is available in your
#    subscription before building for arm64.
# ---------------------------------------------------------------------------
RUN ARCH=$(uname -m) && \
    case "${ARCH}" in \
      x86_64)  RT_REPO="rhel-10-for-x86_64-rt-rpms" \
               BASE_REPO="rhel-10-for-x86_64-baseos-rpms" \
               APP_REPO="rhel-10-for-x86_64-appstream-rpms" ;; \
      aarch64) RT_REPO="rhel-10-for-aarch64-rt-rpms" \
               BASE_REPO="rhel-10-for-aarch64-baseos-rpms" \
               APP_REPO="rhel-10-for-aarch64-appstream-rpms" ;; \
      *)       echo "Unsupported architecture: ${ARCH}" && exit 1 ;; \
    esac && \
    subscription-manager repos \
        --enable "${BASE_REPO}" \
        --enable "${APP_REPO}" \
        --enable "${RT_REPO}"

# ---------------------------------------------------------------------------
# 2. Install Real-Time kernel group + supporting packages
#
#    Tooling additions from prior art:
#      rtla         — Real-Time Linux Analysis tool (histograms, timerlat, osnoise)
#      realtime-tests (rt-tests) — cyclictest, pi_stress, hwlatdetect and friends
#      stress-ng    — workload generator for RT regression testing
#      trace-cmd    — ftrace front-end; essential for RT latency tracing
#      hwloc        — hardware locality inspection (CPU/NUMA/cache topology)
#      tmux         — persistent terminal sessions for long-running RT tests
# ---------------------------------------------------------------------------
RUN dnf groupinstall -y RT && \
    dnf install -y \
        tuna \
        kexec-tools \
        kdump-utils \
        tuned \
        tuned-profiles-realtime \
        util-linux \
        rtla \
        rt-tests \
        stress-ng \
        trace-cmd \
        hwloc \
        tmux \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# ---------------------------------------------------------------------------
# 3. Persist kernel-rt as the default kernel across updates (docs Section 2.3)
# ---------------------------------------------------------------------------
RUN sed -i 's/UPDATEDEFAULT=.*/UPDATEDEFAULT=yes/g'             /etc/sysconfig/kernel && \
    sed -i 's/DEFAULTKERNEL=.*/DEFAULTKERNEL=kernel-rt-core/g'  /etc/sysconfig/kernel

# ---------------------------------------------------------------------------
# 4. Kernel command-line parameters — bootc-native TOML kargs
#
#    Uses /usr/lib/bootc/kargs.d/ (the proper bootc mechanism) instead of
#    /etc/kernel/cmdline.d/. This gives us:
#      - match-architectures: arch-conditional args in a single multi-arch image
#      - clean separation of concerns per-file
#      - correct bootc kargs apply / rollback semantics
#
#    CPU ISOLATION (arch-neutral, written when ISOLATED_CPUS is set):
#      isolcpus=domain,managed_irq,<cpus>  — removes CPUs from SMP domain;
#                                            also isolates managed MSI/MSI-X IRQs
#      nohz_full=<cpus>                    — eliminates periodic tick on isolated
#                                            CPUs (largest single source of RT jitter)
#      rcu_nocbs=<cpus>                    — offloads RCU callbacks to housekeeping CPUs
#      rcutree.nocb_patience_delay=1000    — grace period before RCU wakes nocb kthreads;
#                                            reduces wakeup jitter on isolated CPUs
#
#    IDLE (both arches):
#      idle=poll  — disables CPU idle states entirely; trades power for minimum
#                   latency by busy-looping instead of entering C-states
#
#    x86_64-SPECIFIC:
#      iommu=pt          — IOMMU pass-through; eliminates DMA remapping overhead
#      intel_iommu=on    — explicitly enables Intel VT-d (required before iommu=pt)
#      console=ttyS1,115200 — serial console for headless/BMC access
#
#    aarch64-SPECIFIC:
#      console=tty0 console=ttyAMA0,115200n81 — primary + serial console on ARM
#
#    EXTRA_KARGS (all arches, build-arg escape hatch):
#      Any site-specific or workload-specific args (e.g. skew_tick=1 tsc=reliable).
#      File is omitted entirely when EXTRA_KARGS is empty.
# ---------------------------------------------------------------------------
RUN mkdir -p /usr/lib/bootc/kargs.d

# --- CPU isolation (arch-neutral) ---
RUN if [ -n "${ISOLATED_CPUS}" ]; then \
        printf 'kargs = [\n  "isolcpus=domain,managed_irq,%s",\n  "nohz_full=%s",\n  "rcu_nocbs=%s",\n  "rcutree.nocb_patience_delay=1000"\n]\n' \
            "${ISOLATED_CPUS}" "${ISOLATED_CPUS}" "${ISOLATED_CPUS}" \
            > /usr/lib/bootc/kargs.d/10-rt-isolation.toml ; \
    else \
        printf '# RT CPU isolation — set ISOLATED_CPUS at build time or apply post-deploy:\n#   bootc kargs edit\n# Example contents:\n#   kargs = ["isolcpus=domain,managed_irq,2-15","nohz_full=2-15","rcu_nocbs=2-15","rcutree.nocb_patience_delay=1000"]\n' \
            > /usr/lib/bootc/kargs.d/10-rt-isolation.toml.example ; \
    fi

# --- idle=poll (both arches) ---
RUN printf 'kargs = ["idle=poll"]\n' \
        > /usr/lib/bootc/kargs.d/11-rt-idle.toml

# --- x86_64: IOMMU + console ---
RUN printf 'kargs = ["iommu=pt", "intel_iommu=on"]\nmatch-architectures = ["x86_64"]\n' \
        > /usr/lib/bootc/kargs.d/20-iommu-x86.toml && \
    printf 'kargs = ["console=ttyS1,115200"]\nmatch-architectures = ["x86_64"]\n' \
        > /usr/lib/bootc/kargs.d/21-console-x86.toml

# --- aarch64: console ---
RUN printf 'kargs = ["console=tty0", "console=ttyAMA0,115200n81"]\nmatch-architectures = ["aarch64"]\n' \
        > /usr/lib/bootc/kargs.d/20-console-arm.toml

# --- kdump crashkernel reservation (arch-aware) ---
RUN ARCH=$(uname -m) && \
    case "${ARCH}" in \
      x86_64)  CK="crashkernel=2G-64G:256M,64G-:512M" ;; \
      aarch64) CK="crashkernel=2G-:256M" ;; \
    esac && \
    printf 'kargs = ["%s"]\n' "${CK}" \
        > /usr/lib/bootc/kargs.d/30-kdump.toml

# --- EXTRA_KARGS escape hatch (all arches, only when non-empty) ---
RUN if [ -n "${EXTRA_KARGS}" ]; then \
        # Split space-separated args into a TOML array
        TOML_ARRAY=$(echo "${EXTRA_KARGS}" | tr ' ' '\n' | \
            awk 'NF{printf "%s\"%s\"", (NR>1?", ":""), $0} END{print ""}') && \
        printf 'kargs = [%s]\n' "${TOML_ARRAY}" \
            > /usr/lib/bootc/kargs.d/99-extra-kargs.toml ; \
    fi

# ---------------------------------------------------------------------------
# 5. TuneD — custom profile extending the ARG-selected base profile
#
#    Profile name: "rt-custom"  (stable name regardless of base profile)
#    Location:     /etc/tuned/rt-custom/
#
#    tuned-profiles-realtime consumes two variables:
#      isolated_cores     — CPUs dedicated to RT workloads
#      not_isolated_cores — CPUs for OS housekeeping (irqbalance, kthreads)
#
#    The [include] directive in tuned.conf pulls in the full base profile
#    (realtime / realtime-virtual-host / realtime-virtual-guest) and then
#    our variables.conf overrides just the CPU lists.
# ---------------------------------------------------------------------------
RUN mkdir -p /etc/tuned/rt-custom

RUN printf '[main]\nsummary=Custom RT profile (base: %s)\n\n[variables]\nfile=/etc/tuned/rt-custom/variables.conf\n\n[include]\ninclude=%s\n' \
        "${TUNED_PROFILE}" "${TUNED_PROFILE}" \
        > /etc/tuned/rt-custom/tuned.conf

RUN printf '# CPU isolation variables consumed by tuned-profiles-realtime\nisolated_cores=%s\nnot_isolated_cores=%s\n' \
        "${ISOLATED_CPUS:-}" "${HOUSEKEEPING_CPUS}" \
        > /etc/tuned/rt-custom/variables.conf

# Store base profile name for reference by operators / firstboot script
RUN echo "${TUNED_PROFILE}" > /etc/tuned/rt-selected-profile

# ---------------------------------------------------------------------------
# 6. First-boot service
#    Applies the rt-custom TuneD profile and realtime-setup at runtime.
#    On aarch64: also disables irqbalance (it redistributes IRQs across all
#    CPUs and directly undoes the isolation achieved by isolcpus= on ARM).
#    On x86_64: irqbalance is left enabled but tuna/tuned will pin IRQs away
#    from isolated CPUs, which is the correct x86 behaviour.
#    ConditionPathExists guard ensures it only runs once per deployment.
# ---------------------------------------------------------------------------
COPY --chmod=0755 <<'SCRIPT' /usr/local/bin/rt-firstboot.sh
#!/bin/bash
set -euo pipefail

echo "==> Applying TuneD profile: rt-custom"
tuned-adm profile rt-custom

echo "==> Running realtime-setup"
/usr/bin/realtime-setup

# aarch64: irqbalance redistributes IRQs across all CPUs and undoes
# the isolation achieved by isolcpus= — must be disabled on ARM RT hosts.
# On x86_64 irqbalance is tuna/tuned-aware and is left running.
ARCH=$(uname -m)
if [[ "${ARCH}" == "aarch64" ]]; then
    echo "==> aarch64 detected: disabling irqbalance"
    systemctl disable --now irqbalance.service 2>/dev/null || true
fi

echo "RT first-boot setup complete." | systemd-cat -t rt-firstboot -p info
SCRIPT

COPY --chmod=0644 <<'UNIT' /usr/lib/systemd/system/rt-firstboot.service
[Unit]
Description=Apply Real-Time TuneD profile and environment at first boot
After=tuned.service network.target
Wants=tuned.service
ConditionPathExists=!/var/lib/rt-firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rt-firstboot.sh
ExecStartPost=/bin/touch /var/lib/rt-firstboot.done
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
UNIT

RUN systemctl enable tuned.service && \
    systemctl enable rt-firstboot.service

# ---------------------------------------------------------------------------
# 7. Enable RT-specific systemd services installed by realtime-setup RPM
#    rt-setup.service  — applies RT environment settings (ulimits, udev rules)
#    rt-entsk.service  — sets entropy task scheduling for RT
# ---------------------------------------------------------------------------
RUN systemctl enable rt-setup.service && \
    systemctl enable rt-entsk.service

# ---------------------------------------------------------------------------
# 8. kdump — compressed core collection
#    (crashkernel reservation has moved to TOML kargs in step 4)
# ---------------------------------------------------------------------------
RUN grep -q '^core_collector' /etc/kdump.conf && \
    sed -i 's/^core_collector.*/core_collector makedumpfile -l --message-level 1 -d 31/' \
        /etc/kdump.conf || \
    echo 'core_collector makedumpfile -l --message-level 1 -d 31' >> /etc/kdump.conf

RUN systemctl enable kdump.service

# ---------------------------------------------------------------------------
# 9. sysctl — RT latency + kdump requirements
# ---------------------------------------------------------------------------
COPY --chmod=0644 <<'EOF' /etc/sysctl.d/99-realtime.conf
# Required: allows kdump to load crash kernel when KASLR is enabled (docs 4.9)
kernel.kptr_restrict = 1

# Disable NMI watchdog — periodic NMIs add measurable jitter to RT tasks
kernel.watchdog = 0

# Disable automatic NUMA balancing — causes unexpected task migrations on RT CPUs
kernel.numa_balancing = 0

# Allow RT tasks to consume 100% CPU time (remove the 5% throttle)
# WARNING: a runaway RT task can lock the system. Use with care.
kernel.sched_rt_runtime_us = -1

# Reduce vmstat timer tick interval to lower per-CPU timer jitter
vm.stat_interval = 10
EOF

# ---------------------------------------------------------------------------
# 10. Process limits for real-time workloads
# ---------------------------------------------------------------------------
COPY --chmod=0644 <<'EOF' /etc/security/limits.d/99-realtime-custom.conf
# Members of the 'realtime' group get RT scheduling and unlimited locked memory
@realtime   -   rtprio      99
@realtime   -   memlock     unlimited
@realtime   -   nice       -20
EOF

RUN groupadd -r realtime 2>/dev/null || true

# ---------------------------------------------------------------------------
# 11. OCI image labels — record build-time config in image metadata
# ---------------------------------------------------------------------------
LABEL \
    org.opencontainers.image.title="RHEL bootc Real-Time" \
    org.opencontainers.image.description="RHEL 10 bootc — kernel-rt, CPU isolation, dynamic TuneD RT profile, kdump" \
    org.opencontainers.image.vendor="Red Hat" \
    org.opencontainers.image.base.name="registry.redhat.io/rhel10/rhel-bootc:latest" \
    com.redhat.rt.tuned-profile="${TUNED_PROFILE}" \
    com.redhat.rt.isolated-cpus="${ISOLATED_CPUS}" \
    com.redhat.rt.housekeeping-cpus="${HOUSEKEEPING_CPUS}"