[Unit]
Description=Fix Tegra GPU device group ownership
After=systemd-udev-settle.service
Before=nvidia-cdi.service podman.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c '\
for i in {1..10}; do \
  ls /dev/nvhost-* >/dev/null 2>&1 && break; \
  sleep 1; \
done; \
chown root:gpu /dev/nvhost-* /dev/nvmap && \
chmod 660 /dev/nvhost-* /dev/nvmap'

[Install]
WantedBy=multi-user.target